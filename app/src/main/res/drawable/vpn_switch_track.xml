<?xml version="1.0" encoding="utf-8"?>
<!-- On: filled in the text color, off: outline at half strength -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_checked="true">
        <shape>
            <size
                android:width="48dp"
                android:height="24dp" />
            <corners android:radius="12dp" />
            <solid android:color="?attr/primaryColor" />
        </shape>
    </item>
    <item>
        <shape>
            <size
                android:width="48dp"
                android:height="24dp" />
            <corners android:radius="12dp" />
            <solid android:color="@android:color/transparent" />
            <stroke
                android:width="1dp"
                android:color="?attr/primaryColorTrans50" />
        </shape>
    </item>
</selector>
