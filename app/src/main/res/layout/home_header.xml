<?xml version="1.0" encoding="utf-8"?>
<!-- Shared by the home screen and the lock screen, filled by HomeHeader -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <!-- Battery level as a thin line across the full width, shown while the status bar is hidden -->
    <ProgressBar
        android:id="@+id/batteryBar"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="2dp"
        android:layout_marginBottom="16dp"
        android:contentDescription="@string/battery"
        android:max="100"
        android:maxHeight="2dp"
        android:minHeight="2dp"
        android:progressBackgroundTint="?attr/primaryColor"
        android:progressDrawable="@drawable/battery_bar"
        android:progressTint="?attr/primaryColor"
        android:visibility="gone"
        tools:progress="38"
        tools:visibility="visible" />

    <!-- Date above the clock, weather on the right -->
    <LinearLayout
        android:id="@+id/dateTimeLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:visibility="gone"
        tools:visibility="visible">

        <!-- The clock is the baseline the temperature sits on -->
        <LinearLayout
            android:id="@+id/clockDateLayout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:baselineAlignedChildIndex="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/date"
                style="@style/TextDefault"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:alpha="0.7"
                android:gravity="center_vertical"
                android:letterSpacing="0.1"
                android:minHeight="32dp"
                android:textAllCaps="true"
                android:textSize="15sp"
                tools:text="Di, 20. Okt." />

            <TextClock
                android:id="@+id/clock"
                style="@style/TextDefault"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:fontFamily="sans-serif-light"
                android:format12Hour="h:mm"
                android:includeFontPadding="false"
                android:letterSpacing="-0.04"
                android:textSize="72sp"
                tools:text="21:18" />
        </LinearLayout>

        <Space
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <!-- Weather; the icon is set as a top drawable in code-->
        <TextView
            android:id="@+id/weatherTemperature"
            style="@style/TextDefault"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:fontFamily="sans-serif-light"
            android:gravity="end"
            android:includeFontPadding="false"
            android:textSize="40sp"
            android:visibility="gone"
            tools:text="14°"
            tools:visibility="visible" />
    </LinearLayout>

    <!-- Status row between two hairlines: LAB, Gemma and the WireGuard switch below the weather -->
    <LinearLayout
        android:id="@+id/statusLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:orientation="vertical"
        android:visibility="gone"
        tools:visibility="visible">

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:alpha="0.2"
            android:background="?attr/primaryColor" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/labStatus"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:visibility="gone"
                tools:visibility="visible">

                <TextView
                    android:id="@+id/labDot"
                    style="@style/TextSmall"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:text="@string/lab_dot"
                    android:textSize="12sp" />

                <TextView
                    style="@style/TextSmall"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:alpha="0.6"
                    android:letterSpacing="0.12"
                    android:text="@string/lab"
                    android:textAllCaps="true"
                    android:textSize="11sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/gemmaStatus"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:visibility="gone"
                tools:visibility="visible">

                <TextView
                    android:id="@+id/gemmaDot"
                    style="@style/TextSmall"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:text="@string/lab_dot"
                    android:textSize="12sp" />

                <TextView
                    style="@style/TextSmall"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:alpha="0.6"
                    android:letterSpacing="0.12"
                    android:text="@string/gemma"
                    android:textAllCaps="true"
                    android:textSize="11sp" />
            </LinearLayout>

            <!-- WireGuard tunnel switch, the dot is filled green while a VPN is up -->
            <LinearLayout
                android:id="@+id/vpnLayout"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="2"
                android:gravity="end|center_vertical"
                android:orientation="horizontal"
                android:visibility="gone"
                tools:visibility="visible">

                <View
                    android:id="@+id/vpnDot"
                    android:layout_width="12dp"
                    android:layout_height="12dp"
                    android:layout_marginEnd="12dp"
                    android:background="@drawable/vpn_dot_off" />

                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/vpnSwitch"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:contentDescription="@string/wireguard_tunnel"
                    android:thumb="@drawable/vpn_switch_thumb"
                    app:track="@drawable/vpn_switch_track" />
            </LinearLayout>
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:alpha="0.2"
            android:background="?attr/primaryColor" />
    </LinearLayout>
</LinearLayout>
