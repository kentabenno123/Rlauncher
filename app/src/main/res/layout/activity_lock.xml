<?xml version="1.0" encoding="utf-8"?>
<!-- Prototype: the home screen's header, the free space will hold the notifications -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/lockRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/primaryInverseColor"
    android:orientation="vertical"
    android:paddingHorizontal="24dp"
    android:paddingTop="40dp"
    android:paddingBottom="40dp">

    <include
        android:id="@+id/header"
        layout="@layout/home_header" />

    <Space
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <TextView
        style="@style/TextSmall"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:alpha="0.6"
        android:letterSpacing="0.12"
        android:text="@string/lock_prototype_hint"
        android:textAllCaps="true"
        android:textSize="11sp" />
</LinearLayout>
